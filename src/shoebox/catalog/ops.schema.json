{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shoebox.local/spec/ops.schema.json",
  "title": "Catalog operation",
  "description": "One change to the catalog. Shared by the Python CLI/server and the TypeScript web/mobile clients (LOCAL_APP_PLAN.md §4).",
  "type": "object",
  "required": ["op_id", "hlc", "device_id", "kind", "entity", "body"],
  "additionalProperties": false,
  "properties": {
    "op_id": { "$ref": "#/$defs/hlc" },
    "hlc": { "$ref": "#/$defs/hlc" },
    "device_id": { "$ref": "#/$defs/id" },
    "kind": { "enum": [
      "media.upsert", "media.source", "media.set", "media.caption", "media.text", "media.delete", "media.restore",
      "tag.add", "tag.remove", "album.add", "album.remove",
      "person.create", "person.set", "person.merge", "media.person.add", "media.person.remove",
      "device.register", "device.set"
    ] },
    "entity": { "type": "string", "pattern": "^(media|person|device):.+$" },
    "body": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "media.upsert" } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/upsert" } } } },
    { "if": { "properties": { "kind": { "const": "media.source" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id", "device_id", "source_ref"],
        "additionalProperties": false, "properties": {
          "photo_id": { "$ref": "#/$defs/photo_id" }, "device_id": { "$ref": "#/$defs/id" },
          "source_ref": { "type": "string", "minLength": 1 } } } } } },
    { "if": { "properties": { "kind": { "const": "media.set" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id", "field", "value"],
        "additionalProperties": false, "properties": {
          "photo_id": { "$ref": "#/$defs/photo_id" },
          "field": { "enum": ["title", "description", "favorite", "hidden", "caption"] },
          "value": { "type": ["string", "integer", "boolean", "null"] } } } } } },
    { "if": { "properties": { "kind": { "const": "media.caption" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id", "caption"], "additionalProperties": false,
        "properties": { "photo_id": { "$ref": "#/$defs/photo_id" }, "caption": { "type": "string", "maxLength": 2000 },
          "model": { "type": "string", "maxLength": 100 } } } } } },
    { "if": { "properties": { "kind": { "const": "media.text" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id", "text"], "additionalProperties": false,
        "properties": { "photo_id": { "$ref": "#/$defs/photo_id" }, "text": { "type": "string", "maxLength": 4000 } } } } } },
    { "if": { "properties": { "kind": { "enum": ["media.delete", "media.restore"] } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id"], "additionalProperties": false,
        "properties": { "photo_id": { "$ref": "#/$defs/photo_id" } } } } } },
    { "if": { "properties": { "kind": { "const": "tag.add" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id", "tag"], "additionalProperties": false,
        "properties": { "photo_id": { "$ref": "#/$defs/photo_id" }, "tag": { "$ref": "#/$defs/label" },
          "source": { "enum": ["user", "vision"] } } } } } },
    { "if": { "properties": { "kind": { "const": "tag.remove" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id", "tag", "observed_add_ops"],
        "additionalProperties": false, "properties": { "photo_id": { "$ref": "#/$defs/photo_id" },
          "tag": { "$ref": "#/$defs/label" }, "observed_add_ops": { "$ref": "#/$defs/op_ids" } } } } } },
    { "if": { "properties": { "kind": { "const": "album.add" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id", "album"], "additionalProperties": false,
        "properties": { "photo_id": { "$ref": "#/$defs/photo_id" }, "album": { "$ref": "#/$defs/label" } } } } } },
    { "if": { "properties": { "kind": { "const": "album.remove" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id", "album", "observed_add_ops"],
        "additionalProperties": false, "properties": { "photo_id": { "$ref": "#/$defs/photo_id" },
          "album": { "$ref": "#/$defs/label" }, "observed_add_ops": { "$ref": "#/$defs/op_ids" } } } } } },
    { "if": { "properties": { "kind": { "const": "person.create" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["person_id", "name"], "additionalProperties": false,
        "properties": { "person_id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/label" } } } } } },
    { "if": { "properties": { "kind": { "const": "person.set" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["person_id", "field", "value"],
        "additionalProperties": false, "properties": { "person_id": { "$ref": "#/$defs/id" },
          "field": { "enum": ["name"] }, "value": { "$ref": "#/$defs/label" } } } } } },
    { "if": { "properties": { "kind": { "const": "person.merge" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["from", "into"], "additionalProperties": false,
        "properties": { "from": { "$ref": "#/$defs/id" }, "into": { "$ref": "#/$defs/id" } } } } } },
    { "if": { "properties": { "kind": { "const": "media.person.add" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id", "person_id"], "additionalProperties": false,
        "properties": { "photo_id": { "$ref": "#/$defs/photo_id" }, "person_id": { "$ref": "#/$defs/id" },
          "source": { "enum": ["user", "face"] } } } } } },
    { "if": { "properties": { "kind": { "const": "media.person.remove" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["photo_id", "person_id", "observed_add_ops"],
        "additionalProperties": false, "properties": { "photo_id": { "$ref": "#/$defs/photo_id" },
          "person_id": { "$ref": "#/$defs/id" }, "observed_add_ops": { "$ref": "#/$defs/op_ids" } } } } } },
    { "if": { "properties": { "kind": { "const": "device.register" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["device_id", "name", "platform"],
        "additionalProperties": false, "properties": { "device_id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/label" },
          "platform": { "enum": ["macos", "ios", "android", "web", "linux", "windows", "unknown"] } } } } } },
    { "if": { "properties": { "kind": { "const": "device.set" } } },
      "then": { "properties": { "body": { "type": "object", "required": ["device_id", "field", "value"],
        "additionalProperties": false, "properties": { "device_id": { "$ref": "#/$defs/id" },
          "field": { "enum": ["name"] }, "value": { "$ref": "#/$defs/label" } } } } } }
  ],
  "$defs": {
    "hlc": { "type": "string", "pattern": "^[0-9]{13}-[0-9]{4}-[0-9A-Za-z_.:-]+$" },
    "id": { "type": "string", "pattern": "^[0-9A-Za-z_.:-]{1,64}$" },
    "photo_id": { "type": "string", "pattern": "^[A-Z2-7]{26}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 200 },
    "op_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 10000 },
    "upsert": {
      "type": "object", "required": ["record"], "additionalProperties": false,
      "properties": {
        "record": { "type": "object", "required": ["photo_id", "keys", "file"],
          "properties": {
            "photo_id": { "$ref": "#/$defs/photo_id" },
            "media_type": { "enum": ["photo", "video"] },
            "keys": { "type": "object", "required": ["raw", "meta"] },
            "file": { "type": "object", "required": ["sha256"] }
          } },
        "bytes_compressed": { "type": ["integer", "null"] },
        "needs_derivatives": { "type": "boolean" }
      }
    }
  }
}
