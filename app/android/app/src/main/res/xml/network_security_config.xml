<?xml version="1.0" encoding="utf-8"?>
<!-- The app only talks to your Mac: over Tailscale (https://<mac>.<tailnet>.ts.net) or, after pairing,
     over your home Wi-Fi with plain http (shoebox serve with the lan option). Android can't limit cleartext to private IP
     ranges, so it's allowed; the start page only accepts ts.net, private-network and .local addresses. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
