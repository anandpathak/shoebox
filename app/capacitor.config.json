{
  "appId": "app.photoframing",
  "appName": "Photoframing",
  "webDir": "www",
  "server": {
    "allowNavigation": ["*.ts.net", "*.local", "192.168.*.*", "10.*.*.*", "172.*.*.*", "127.0.0.1", "localhost"]
  },
  "ios": { "contentInset": "never", "limitsNavigationsToAppBoundDomains": false },
  "android": { "allowMixedContent": false }
}
