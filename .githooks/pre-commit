#!/bin/sh
# Blocks commits that would leak secrets, personal photos, databases or Terraform state.
# Installed via: git config core.hooksPath .githooks
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1. Files that must never be committed.
bad_files=$(printf '%s\n' "$staged" | grep -E -i '\.(sqlite|sqlite-wal|sqlite-shm|db|tfstate|tfvars|tfplan|pem|key|heic|jpe?g|png|mov|mp4|dng|cr2|nef|arw)$|(^|/)\.env(\.|$)|(^|/)(config\.toml|device\.json)$|^(library|test-output)/')
if [ -n "$bad_files" ]; then
  echo "pre-commit: refusing to commit personal data, databases, state or secrets:" >&2
  printf '  %s\n' $bad_files >&2
  fail=1
fi

# 2. Large files (> 2 MB).
for f in $staged; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -gt 2097152 ] && [ "$f" != "uv.lock" ]; then
    echo "pre-commit: $f is larger than 2 MB" >&2; fail=1
  fi
done

# 3. Secret patterns in staged content.
patterns='AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|aws_secret_access_key|aws_session_token|BEGIN [A-Z ]*PRIVATE KEY|arn:aws:[a-z0-9-]*:[a-z0-9-]*:[0-9]{12}:|sk-ant-[A-Za-z0-9_-]{10,}|ghp_[A-Za-z0-9]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}'
hits=$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude).githooks/pre-commit' | grep -E '^\+' | grep -E -n "$patterns")
if [ -n "$hits" ]; then
  echo "pre-commit: possible secret in staged changes:" >&2
  printf '%s\n' "$hits" | cut -c1-160 >&2
  fail=1
fi

# 4. Personal email addresses (common providers + this machine's git email).
me=$(git config user.email | sed 's/[.[\*^$+?(){}|]/\\&/g')
email_re='[A-Za-z0-9._%+-]+@(gmail|googlemail|yahoo|outlook|hotmail|live|icloud|me|proton|protonmail)\.[a-z.]+'
[ -n "$me" ] && email_re="$email_re|$me"
mails=$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude).githooks/pre-commit' | grep -E '^\+' | grep -E -o "$email_re" | sort -u)
if [ -n "$mails" ]; then
  echo "pre-commit: personal email address in staged changes:" >&2
  printf '  %s\n' $mails >&2
  fail=1
fi

# 5b. Apple team ids belong in app/ios/local-signing.xcconfig (git-ignored), not the Xcode project.
team=$(git diff --cached -U0 -- '*.pbxproj' | grep -E '^\+' | grep -E 'DEVELOPMENT_TEAM = "?[A-Z0-9]{10}' )
if [ -n "$team" ]; then
  echo "pre-commit: your Apple team id is in the Xcode project. Run: (cd app && npm run ios:signing)" >&2
  fail=1
fi

# 5. The commit itself would carry the author's email: it must not be a personal address.
author=$(git config user.email)
if printf '%s' "$author" | grep -E -q '@(gmail|googlemail|yahoo|outlook|hotmail|live|icloud|me|proton|protonmail)\.'; then
  echo "pre-commit: commits would carry your personal email ($author)." >&2
  echo "  Use a no-reply address in this repo: git config user.email <username>@users.noreply.github.com" >&2
  fail=1
fi

[ "$fail" -eq 0 ] || { echo "Commit blocked. Remove the items above (or unstage them) and try again." >&2; exit 1; }
